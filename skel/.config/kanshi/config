# FluorineOS display profiles for kanshi.
#
# kanshi applies a profile whenever the connected outputs change, so docking or
# unplugging an external monitor reconfigures the session without manual
# hyprctl calls. The wildcard profile below matches every output and keeps the
# preferred mode, automatic placement, and unity scale from hyprland.lua.
#
# Inspect the current outputs with `hyprctl monitors` before adding a profile
# with explicit connector names.

profile {
    output "*" mode "preferred" position "auto" scale 1
}

# Example docked laptop layout. Uncomment and replace the connector names with
# the values reported by `hyprctl monitors`.
#
