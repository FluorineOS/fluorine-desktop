{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/mode",
        "custom/system",
        "custom/power",
        "bluetooth",
        "network",
        "pulseaudio",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "WIFI {essid}",
        "format-ethernet": "ETH {ifname}",
        "format-linked": "ETH {ifname}",
        "format-disconnected": "OFFLINE",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} {signaldBm} dBm\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "flr-tui nmtui"
    },

    "bluetooth": {
        "format": "BT {status}",
        "format-disabled": "BT OFF",
        "format-connected": "BT {num_connections}",
        "tooltip-format": "{controller_alias} {controller_address}",
        "tooltip-format-connected": "{controller_alias} {controller_address}\n{device_enumerate}",
        "on-click": "flr-bt",
        "on-click-right": "flr-tui bluetoothctl"
    },

    "custom/mode": {
        "exec": "flr-mode status",
        "interval": 0,
        "signal": 10,
        "tooltip": "Workstation mode (SUPER + M)",
        "on-click": "flr-mode"
    },

    "custom/system": {
        "format": "SYS",
        "tooltip": "System menu (SUPER + Escape)",
        "on-click": "flr-ctl",
        "on-click-right": "flr-tui flr-update"
    },

    "custom/power": {
        "exec": "flr-power waybar",
        "return-type": "json",
        "interval": 10,
        "on-click": "flr-power cycle"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% CHG",
        "format-plugged": "BAT {capacity}% AC",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "{calendar}"
    }
}
