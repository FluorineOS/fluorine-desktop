#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-doctor"
readonly version="0.0.1"
readonly rule="--------------------------------------------------------------------------"
readonly apt_repo_url="https://fluorineos.github.io/apt-repo"

ok_count=0
warn_count=0
info_count=0

usage() {
    printf 'Usage: %s\n\n' "${program}"
    printf 'Print a fast FluorineOS hardware, session, and service health report.\n'
}

section() {
    printf '\n%s\n%s\n' "$1" "${rule}"
}

tagged() {
    local tag="$1"
    local label="$2"
    local value="$3"

    case "${tag}" in
        OK) ok_count=$((ok_count + 1)) ;;
        WARN) warn_count=$((warn_count + 1)) ;;
        INFO) info_count=$((info_count + 1)) ;;
    esac

    printf '  [%-4s] %-28s %s\n' "${tag}" "${label}" "${value}"
}

case "${1:-}" in
    "")
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

printf 'FluorineOS diagnostics %s\n' "${version}"

section "OS and boot"

pretty_name="unknown"
if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    pretty_name="${PRETTY_NAME:-unknown}"
fi
tagged OK "Distribution" "${pretty_name}"
tagged OK "Kernel" "$(uname -r 2>/dev/null || printf 'unknown')"

if [[ -d /sys/firmware/efi ]]; then
    tagged OK "Firmware" "UEFI (/sys/firmware/efi present)"
else
    tagged WARN "Firmware" "Legacy BIOS (/sys/firmware/efi absent)"
fi

section "Graphics and session"

session_type="${XDG_SESSION_TYPE:-unset}"
if [[ "${session_type}" == "wayland" ]]; then
    tagged OK "XDG_SESSION_TYPE" "${session_type}"
else
    tagged WARN "XDG_SESSION_TYPE" "${session_type}"
fi

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    tagged OK "HYPRLAND_INSTANCE_SIGNATURE" "${HYPRLAND_INSTANCE_SIGNATURE}"
else
    tagged WARN "HYPRLAND_INSTANCE_SIGNATURE" "unset"
fi

gpu_drivers=()
for driver_link in /sys/class/drm/card[0-9]*/device/driver; do
    [[ -e "${driver_link}" ]] || continue
    driver="$(basename "$(readlink -f "${driver_link}")")"
    duplicate=0
    for known in ${gpu_drivers[@]+"${gpu_drivers[@]}"}; do
        if [[ "${known}" == "${driver}" ]]; then
            duplicate=1
            break
        fi
    done
    if ((duplicate == 0)); then
        gpu_drivers+=("${driver}")
    fi
done

if ((${#gpu_drivers[@]} > 0)); then
    tagged OK "DRM GPU driver" "${gpu_drivers[*]}"
else
    tagged WARN "DRM GPU driver" "no /sys/class/drm card device"
fi

render_nodes=0
for node in /dev/dri/renderD*; do
    [[ -e "${node}" ]] || continue
    render_nodes=$((render_nodes + 1))
done

software_render=0
if ((render_nodes == 0)); then
    software_render=1
fi
if [[ "${LIBGL_ALWAYS_SOFTWARE:-0}" == "1" ]]; then
    software_render=1
fi
if [[ -n "${WLR_RENDERER_ALLOW_SOFTWARE:-}" ]]; then
    software_render=1
fi
for driver in ${gpu_drivers[@]+"${gpu_drivers[@]}"}; do
    case "${driver}" in
        simpledrm | vgem | swrast | vkms)
            software_render=1
            ;;
    esac
done

if ((software_render == 0)); then
    tagged OK "Rendering" "hardware (${render_nodes} render node)"
else
    tagged WARN "Rendering" "software (${render_nodes} render node)"
fi

section "Audio and connectivity"

if systemctl --user is-active --quiet pipewire 2>/dev/null; then
    tagged OK "pipewire" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x pipewire >/dev/null 2>&1; then
    tagged OK "pipewire" "running"
else
    tagged WARN "pipewire" "inactive"
fi

if systemctl --user is-active --quiet wireplumber 2>/dev/null; then
    tagged OK "wireplumber" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x wireplumber >/dev/null 2>&1; then
    tagged OK "wireplumber" "running"
else
    tagged WARN "wireplumber" "inactive"
fi

if command -v wpctl >/dev/null 2>&1; then
    if wp_output="$(wpctl status 2>/dev/null)"; then
        sink_count="$(printf '%s\n' "${wp_output}" | awk '
            /Sinks:/ { in_sinks = 1; next }
            /Sources:|Filters:|Streams:|Clients:/ { in_sinks = 0 }
            in_sinks && NF { count++ }
            END { print count + 0 }
        ')"
        if ((sink_count > 0)); then
            tagged OK "wpctl status" "${sink_count} audio sink(s)"
        else
            tagged WARN "wpctl status" "no audio sink"
        fi
    else
        tagged WARN "wpctl status" "no response from PipeWire"
    fi
else
    tagged INFO "wpctl status" "unavailable (wireplumber not installed)"
fi

if command -v nmcli >/dev/null 2>&1; then
    nm_state="$(nmcli -t -f STATE general 2>/dev/null | head -n 1 || true)"
    if [[ "${nm_state}" == "connected" ]]; then
        tagged OK "NetworkManager" "${nm_state}"
    elif [[ -n "${nm_state}" ]]; then
        tagged WARN "NetworkManager" "${nm_state}"
    else
        tagged WARN "NetworkManager" "no response from nmcli"
    fi

    nm_wifi="$(nmcli -t -f WIFI general 2>/dev/null | head -n 1 || true)"
    if [[ "${nm_wifi}" == "enabled" ]]; then
        tagged OK "Wi-Fi radio" "${nm_wifi}"
    elif [[ -n "${nm_wifi}" ]]; then
        tagged INFO "Wi-Fi radio" "${nm_wifi}"
    else
        tagged INFO "Wi-Fi radio" "not reported"
    fi
else
    tagged INFO "NetworkManager" "unavailable (nmcli not found)"
fi

bluetooth_found=0
for hci in /sys/class/bluetooth/hci*; do
    [[ -e "${hci}" ]] || continue
    bluetooth_found=$((bluetooth_found + 1))
done

if ((bluetooth_found == 0)); then
    tagged INFO "Bluetooth" "no controller"
elif command -v bluetoothctl >/dev/null 2>&1; then
    bt_powered="$(bluetoothctl show 2>/dev/null | awk -F': ' '/Powered:/ { print $2; exit }' || true)"
    if [[ "${bt_powered}" == "yes" ]]; then
        tagged OK "Bluetooth" "powered (${bluetooth_found} controller)"
    else
        tagged WARN "Bluetooth" "present but not powered"
    fi
else
    tagged INFO "Bluetooth" "${bluetooth_found} controller (bluetoothctl missing)"
fi

battery_found=0
for battery in /sys/class/power_supply/BAT*; do
    [[ -e "${battery}/capacity" ]] || continue
    battery_found=$((battery_found + 1))
    capacity="$(cat "${battery}/capacity" 2>/dev/null || printf 'unknown')"
    status="$(cat "${battery}/status" 2>/dev/null || printf 'unknown')"
    if ((battery_found == 1)); then
        tagged INFO "Battery" "${capacity}% (${status})"
    fi
done
if ((battery_found == 0)); then
    tagged INFO "Battery" "none detected (desktop or VM)"
fi

backlight_found=0
for backlight in /sys/class/backlight/*; do
    [[ -e "${backlight}" ]] || continue
    backlight_found=$((backlight_found + 1))
done
if ((backlight_found > 0)); then
    tagged OK "Backlight" "${backlight_found} device(s)"
else
    tagged INFO "Backlight" "none detected"
fi

section "System services"

zram_devices=0
if command -v zramctl >/dev/null 2>&1; then
    zram_output="$(zramctl --noheadings --output NAME 2>/dev/null || true)"
    if [[ -n "${zram_output}" ]]; then
        zram_devices="$(printf '%s\n' "${zram_output}" | awk 'NF { count++ } END { print count + 0 }')"
    fi
fi

zram_swap=0
if [[ -r /proc/swaps ]] && grep -q '^/dev/zram' /proc/swaps 2>/dev/null; then
    zram_swap=1
fi

if ((zram_devices > 0 && zram_swap == 1)); then
    tagged OK "zram swap" "${zram_devices} device(s) active"
elif ((zram_devices > 0)); then
    tagged WARN "zram swap" "${zram_devices} device(s), not used as swap"
else
    tagged WARN "zram swap" "no zram device"
fi

ufw_state="unknown"
if command -v ufw >/dev/null 2>&1; then
    if ufw_output="$(ufw status 2>/dev/null)"; then
        ufw_state="$(printf '%s\n' "${ufw_output}" | head -n 1)"
    else
        ufw_state="unreadable without root"
    fi
else
    ufw_state="ufw not installed"
fi
case "${ufw_state}" in
    "Status: active")
        tagged OK "ufw" "active"
        ;;
    "Status: inactive")
        tagged WARN "ufw" "inactive"
        ;;
    *)
        tagged INFO "ufw" "${ufw_state}"
        ;;
esac

if systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null; then
    tagged OK "xdg-desktop-portal-hyprland" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x xdg-desktop-portal-hyprland >/dev/null 2>&1; then
    tagged OK "xdg-desktop-portal-hyprland" "running"
else
    tagged WARN "xdg-desktop-portal-hyprland" "inactive"
fi

if command -v curl >/dev/null 2>&1; then
    http_code="$(curl -sS -o /dev/null --max-time 5 -w '%{http_code}' "${apt_repo_url}" 2>/dev/null || true)"
    case "${http_code}" in
        200 | 301 | 302)
            tagged OK "APT repository" "reachable (HTTP ${http_code})"
            ;;
        000 | "")
            tagged WARN "APT repository" "unreachable"
            ;;
        *)
            tagged WARN "APT repository" "HTTP ${http_code}"
            ;;
    esac
else
    tagged INFO "APT repository" "curl not installed"
fi

section "Summary"
printf '  %s: %d OK, %d WARN, %d INFO\n' "${program}" \
    "${ok_count}" "${warn_count}" "${info_count}"
