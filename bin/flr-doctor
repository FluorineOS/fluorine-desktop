#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-doctor"
readonly version="0.0.1"

usage() {
    printf 'Usage: %s\n\n' "${program}"
    printf 'Print FluorineOS %s system diagnostics.\n' "${version}"
}

report() {
    printf '  %-30s %s\n' "$1" "$2"
}

section() {
    printf '\n%s\n' "$1"
    printf '%s\n' "------------------------------------------------------------"
}

case "${1:-}" in
    "")
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

section "FluorineOS"
report "Version" "${version}"

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    report "Distribution" "${PRETTY_NAME:-unknown}"
    report "Base" "${VERSION_CODENAME:-unknown}"
else
    report "Distribution" "unknown"
fi

section "Session"
report "XDG_SESSION_TYPE" "${XDG_SESSION_TYPE:-unset}"
report "XDG_CURRENT_DESKTOP" "${XDG_CURRENT_DESKTOP:-unset}"
report "HYPRLAND_INSTANCE_SIGNATURE" "${HYPRLAND_INSTANCE_SIGNATURE:-unset}"

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    hypr_version=""
    if ! hypr_version="$(hyprctl version -j 2>/dev/null | jq -r '.tag // "unknown"')"; then
        hypr_version="unknown"
    fi
    report "Hyprland" "${hypr_version:-unknown}"
else
    report "Hyprland" "unavailable (hyprctl or jq not found)"
fi

section "Portals"
if systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null; then
    report "xdg-desktop-portal-hyprland" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x xdg-desktop-portal-hyprland >/dev/null 2>&1; then
    report "xdg-desktop-portal-hyprland" "running"
else
    report "xdg-desktop-portal-hyprland" "inactive"
fi

section "Audio"
if systemctl --user is-active --quiet pipewire 2>/dev/null; then
    report "pipewire" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x pipewire >/dev/null 2>&1; then
    report "pipewire" "running"
else
    report "pipewire" "inactive"
fi

if systemctl --user is-active --quiet wireplumber 2>/dev/null; then
    report "wireplumber" "active"
elif command -v pgrep >/dev/null 2>&1 && pgrep -x wireplumber >/dev/null 2>&1; then
    report "wireplumber" "running"
else
    report "wireplumber" "inactive"
fi

section "Renderer"
renderer=""

if command -v eglinfo >/dev/null 2>&1; then
    renderer="$(eglinfo -B 2>/dev/null | awk '/OpenGL renderer|OpenGL core profile renderer/ { print; exit }' || true)"
fi

if [[ -z "${renderer}" ]] && command -v glxinfo >/dev/null 2>&1; then
    renderer="$(glxinfo -B 2>/dev/null | awk '/OpenGL renderer string/ { print; exit }' || true)"
fi

if [[ -z "${renderer}" ]]; then
    renderer="unavailable (install mesa-utils or eglinfo)"
fi

report "OpenGL / EGL" "${renderer}"
