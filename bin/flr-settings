#!/usr/bin/env python3
"""FluorineOS Settings.

A native GTK4 and libadwaita control panel for the FluorineOS desktop. Every
control delegates to an existing flr-* command, so the graphical panel and the
keyboard workflow always read and write the same state.

Sections: Appearance, Workstation, Displays, Network and Bluetooth, Audio, and
System and Snapshots.
"""

import json
import os
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Adw, Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

APP_ID = "org.fluorineos.Settings"
SYSTEM_WALL_DIR = Path("/usr/share/backgrounds/fluorine")
USER_WALL_DIR = Path.home() / "Pictures" / "Wallpapers"
CONFIG_FILE = Path(GLib.get_user_config_dir()) / "fluorine" / "config.lua"
STATE_DIR = Path(GLib.get_user_state_dir()) / "fluorine"
SHADER_STATE = STATE_DIR / "shader"
WALL_STATE = STATE_DIR / "wallpaper"
ONBOARD_MARKER = STATE_DIR / "onboarded"

IDLE_LABELS = ("5m", "10m", "15m", "Never")
IDLE_SECONDS = (300, 600, 900, 0)
BORDER_LABELS = ("1px", "1.5px", "2px")
BORDER_VALUES = (1, 1.5, 2)
SCALE_VALUES = (1.0, 1.25, 1.5)
POWER_PROFILES = ("power-saver", "balanced", "performance")
SHADERS = ("off", "night", "mono")
MODES = ("work", "focus", "present")

CONFIG_DEFAULTS = {"gaps_in": 4, "gaps_out": 6, "border_size": 2, "idle_lock": 300}

