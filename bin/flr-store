#!/usr/bin/env python3
"""FluorineOS Store.

A curated application hub for the FluorineOS desktop. The hub groups verified
developer tools, browsers, and media software into curated categories and
installs them through apt, Flatpak, or a flr-box Distrobox container. Installs
run on worker threads and report progress through the inline status pill and
toasts, so the interface stays responsive while package work runs.
"""

import os
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Adw, Gdk, GdkPixbuf, GLib, Gtk

APP_ID = "org.fluorineos.Store"

CSS = """
