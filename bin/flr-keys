#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-keys"
readonly prompt="Keys > "

usage() {
    printf 'Usage: %s\n\n' "${program}"
    printf 'List the active Hyprland keybinds in a searchable fuzzel menu.\n'
}

die() {
    printf '%s: %s\n' "${program}" "$*" >&2
    exit 1
}

case "${1:-}" in
    "")
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

for tool in hyprctl jq fuzzel; do
    command -v "${tool}" >/dev/null 2>&1 || die "required tool not found: ${tool}"
done

# Hyprland reports modifiers as a bitmask. Decode the bits into names so the
# menu reads like a normal keybind list. The filter below is a jq program, so
# its $mask and $value parameters must not be expanded by the shell.
#
# Dispatchers are also translated, because "SUPER + Q killactive" means nothing
# to someone who has not read the Hyprland wiki. Every unknown dispatcher falls
# through to its own name instead of disappearing, so a bind added in the user's
# own config is still listed.
# shellcheck disable=SC2016
readonly jq_filter='
def bit($mask; $value): (($mask / $value) | floor) % 2 == 1;
def mods:
    (if bit(.modmask; 1) then "SHIFT + " else "" end)
    + (if bit(.modmask; 2) then "CAPS + " else "" end)
    + (if bit(.modmask; 4) then "CTRL + " else "" end)
    + (if bit(.modmask; 8) then "ALT + " else "" end)
    + (if bit(.modmask; 16) then "MOD2 + " else "" end)
    + (if bit(.modmask; 32) then "MOD3 + " else "" end)
    + (if bit(.modmask; 64) then "SUPER + " else "" end)
    + (if bit(.modmask; 128) then "MOD5 + " else "" end);
def arg: (.arg // "");
def describe:
    if .dispatcher == "exec" then "run " + arg
    elif .dispatcher == "killactive" then "close this window"
    elif .dispatcher == "fullscreen" then
        (if arg == "1" then "fullscreen" elif arg == "0" then "leave fullscreen" else "toggle fullscreen" end)
    elif .dispatcher == "togglefloating" then "toggle floating"
    elif .dispatcher == "pseudo" then "toggle pseudo-tile"
    elif .dispatcher == "togglesplit" then "toggle split direction"
    elif .dispatcher == "movefocus" then "focus " + arg
    elif .dispatcher == "swapwindow" then "swap with " + arg
    elif .dispatcher == "movewindow" then "move window with the pointer"
    elif .dispatcher == "resizewindow" then "resize window with the pointer"
    elif .dispatcher == "resizeactive" then "resize this window"
    elif .dispatcher == "workspace" then "go to workspace " + arg
    elif .dispatcher == "movetoworkspace" then "move window to workspace " + arg
    elif .dispatcher == "movetoworkspacesilent" then "move window to workspace " + arg
    elif .dispatcher == "cyclenext" then "next window"
    elif .dispatcher == "dpms" then "display " + arg
    elif .dispatcher == "exit" then "log out"
    else .dispatcher end;
.[]
| [(mods + .key), describe, (if .dispatcher == "exec" then arg else "" end)]
| @tsv
'

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    die "HYPRLAND_INSTANCE_SIGNATURE is not set; run this from a Hyprland session"
fi

if ! binds="$(hyprctl binds -j)"; then
    die "could not read keybinds from Hyprland"
fi

if ! rows="$(jq -r "${jq_filter}" <<<"${binds}")"; then
    die "could not format the Hyprland keybinds"
fi

if [ -z "${rows}" ]; then
    die "Hyprland reported no keybinds"
fi

selection=""
if ! selection="$(fuzzel --dmenu --prompt="${prompt}" <<<"${rows}")"; then
    exit 0
fi

if [[ -z "${selection}" ]]; then
    exit 0
fi

printf '%s\n' "${selection}"
