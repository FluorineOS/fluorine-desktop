#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-shader"
readonly shader_dir="/usr/share/fluorineos/shaders"
readonly state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/fluorine"
readonly state_file="${state_dir}/shader"
readonly shaders=(off night mono)

usage() {
    printf 'Usage: %s [off|night|mono|cycle|restore|status]\n\n' "${program}"
    printf 'Switch the Hyprland display shader through decoration:screen_shader.\n'
    printf 'With no argument, a Fuzzel picker opens (or the status is printed when\n'
    printf 'Fuzzel is unavailable).\n\n'
    printf 'Shaders:\n'
    printf '  off      Color-accurate default. No shader is loaded.\n'
    printf '  night    Warm low-blue-light pass for late sessions.\n'
    printf '  mono     Pure grayscale focus mode.\n\n'
    printf 'Commands:\n'
    printf '  cycle    Advance off, night, mono. Bound to SUPER + Shift + N.\n'
    printf '  restore  Reapply the saved shader, used at session start.\n'
    printf '  status   Print the current shader name.\n'
}

die() {
    printf '%s: %s\n' "${program}" "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*" >&2
}

label_for() {
    case "$1" in
        off) printf 'OFF' ;;
        night) printf 'NIGHT' ;;
        mono) printf 'MONO' ;;
    esac
}

valid_shader() {
    local candidate=$1
    local known

    for known in "${shaders[@]}"; do
        if [ "${candidate}" = "${known}" ]; then
            return 0
        fi
    done

    return 1
}

current_shader() {
    local saved="off"

    if [ -f "${state_file}" ]; then
        saved=$(<"${state_file}")
    fi

    if valid_shader "${saved}"; then
        printf '%s' "${saved}"
        return 0
    fi

    printf 'off'
}

hyprland_active() {
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1
}

write_state() {
    mkdir -p "${state_dir}"
    printf '%s' "$1" >"${state_file}"
}

# decoration:screen_shader takes an absolute path to a GLSL file, or an empty
# string to load no shader at all. Hyprland recompiles it on the spot, so no
# compositor restart is involved.
apply_shader() {
    local name=$1
    local path=""

    valid_shader "${name}" || die "unknown shader: ${name}"

    if [ "${name}" != "off" ]; then
        path="${shader_dir}/${name}.glsl"
        [ -f "${path}" ] || die "shader file not found: ${path}"
    fi

    write_state "${name}"

    if ! hyprland_active; then
        note "${program}: Hyprland is not running; saved $(label_for "${name}") for the next session"
        return 0
    fi

    if ! hyprctl keyword decoration:screen_shader "${path}" >/dev/null; then
        die "hyprctl rejected the shader change"
    fi

    printf 'Shader: %s\n' "$(label_for "${name}")"
}

next_shader() {
    case "$(current_shader)" in
        off) printf 'night' ;;
        night) printf 'mono' ;;
        mono) printf 'off' ;;
    esac
}

pick_shader() {
    local selection

    if ! command -v fuzzel >/dev/null 2>&1; then
        printf 'Shader: %s\n' "$(label_for "$(current_shader)")"
        return 0
    fi

    selection=$(printf '%s\n' "${shaders[@]}" |
        fuzzel --dmenu --prompt "Shader > " --lines 3 --width 24) || exit 0

    [ -n "${selection}" ] || exit 0
    apply_shader "${selection}"
}

main() {
    case "${1:-}" in
        "")
            pick_shader
            ;;
        -h | --help)
            usage
            ;;
        status)
            printf '%s\n' "$(label_for "$(current_shader)")"
            ;;
        cycle)
            apply_shader "$(next_shader)"
            ;;
        restore)
            apply_shader "$(current_shader)"
            ;;
        off | night | mono)
            apply_shader "$1"
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
