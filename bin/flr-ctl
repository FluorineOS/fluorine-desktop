#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-ctl"
readonly prompt="System > "
# Two columns: the action on the left, its shortcut on the right. Fuzzel runs
# in JetBrains Mono through fuzzel.ini, so padding to a fixed width lines the
# hints up down the menu.
readonly menu_width=36

# Each row carries the icon Fuzzel should draw beside it. The Rofi extended
# dmenu protocol appends a NUL, the literal "icon", a unit separator, and the
# themed icon name; Fuzzel strips that suffix before printing the selection.
row() {
    printf '%-*s%s\0icon\x1f%s\n' "${menu_width}" "$1" "$2" "$3"
}

usage() {
    printf 'Usage: %s\n\n' "${program}"
    printf 'Open the FluorineOS system menu in Fuzzel. The graphical settings\n'
    printf 'panel, network, Bluetooth, display layout, audio, display shader, power,\n'
    printf 'snapshots, workstation mode, diagnostics, the system monitor, and\n'
    printf 'session actions are\n'
    printf 'reachable from the keyboard alone.\n'
}

die() {
    printf '%s: %s\n' "${program}" "$*" >&2
    exit 1
}

command -v fuzzel >/dev/null 2>&1 || die "fuzzel is required but was not found"

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "")
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

# Launch a graphical control panel as a floating, centred window. The inline
# rule only applies inside a Hyprland session; elsewhere the window opens
# normally.
launch_gui() {
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        exec hyprctl dispatch exec "[float;size 980 700;center] $1"
    fi

    exec "$1"
}

launch_tui() {
    if command -v flr-tui >/dev/null 2>&1; then
        exec flr-tui "$@"
    fi

    die "flr-tui is required to open $1 in a terminal"
}

# btop gets its own window class so the Hyprland rule can float it at a
# readable size without touching tiled terminals.
launch_monitor() {
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        exec hyprctl dispatch exec "[float;size 900 560;center] kitty --class flr-btop -e btop"
    fi

    exec kitty --class flr-btop -e btop
}

# A persistent terminal keeps diagnostic output readable after the command
# exits, which is the point of the doctor entry.
launch_persistent_tui() {
    if command -v kitty >/dev/null 2>&1; then
        if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
            exec hyprctl dispatch exec "[float;size 1100 720;center] kitty --hold --class flr-tui -e $1"
        fi

        exec kitty --hold --class flr-tui -e "$1"
    fi

    exec "$1"
}

audio_menu() {
    if command -v wiremix >/dev/null 2>&1; then
        launch_tui wiremix
    fi

    if command -v pulsemixer >/dev/null 2>&1; then
        launch_tui pulsemixer
    fi

    if command -v pavucontrol >/dev/null 2>&1; then
        launch_gui pavucontrol
    fi

    die "no audio mixer is installed"
}

power_profile() {
    local label

    if ! command -v flr-power >/dev/null 2>&1; then
        return 1
    fi

    label="$(flr-power 2>/dev/null || true)"
    if [ -z "${label}" ] || [ "${label}" = "PWR N/A" ]; then
        return 1
    fi

    printf '%s' "${label}"
}

power_entry="Power Profile"
if profile_label="$(power_profile)"; then
    power_entry="Power Profile (${profile_label})"
fi

entries=(
    "Application Hub|SUPER + S|flr-ctl"
    "Settings|SUPER + ,|flr-settings"
    "Network Settings||flr-network"
    "Bluetooth Devices||flr-bluetooth"
    "Display Layout||flr-display"
    "Audio Mixer||flr-audio"
    "Display Shader|SUPER + SHIFT + N|flr-shader"
    "Wallpaper|SUPER + W|flr-wall"
    "${power_entry}||flr-power"
    "Keybinding Cheatsheet|SUPER + /|flr-keys"
    "System Diagnostics||flr-doctor"
    "System Monitor||flr-monitor"
    "Snapshots||flr-snapshot"
    "Workstation Mode|SUPER + M|flr-mode"
    "Lock Session|SUPER + L|flr-lock"
    "Suspend||flr-suspend"
    "Reboot||flr-reboot"
    "Shut Down||flr-poweroff"
)

menu() {
    local entry label hint icon

    for entry in "${entries[@]}"; do
        IFS='|' read -r label hint icon <<<"${entry}"
        row "${label}" "${hint}" "${icon}"
    done
}

selection="$(menu | fuzzel --dmenu --prompt "${prompt}" --lines 18 --width 48)" || exit 0

case "${selection}" in
    "Application Hub"*)
        exec flr-store
        ;;
    "Settings"*)
        exec flr-settings
        ;;
    "Network Settings"*)
        if command -v flr-tui >/dev/null 2>&1; then
            launch_tui nmtui
        fi
        die "flr-tui is required to open nmtui"
        ;;
    "Bluetooth Devices"*)
        exec flr-bt
        ;;
    "Display Layout"*)
        launch_gui wdisplays
        ;;
    "Audio Mixer"*)
        audio_menu
        ;;
    "Display Shader"*)
        exec flr-shader
        ;;
    "Wallpaper"*)
        exec flr-wall
        ;;
    "Power Profile"*)
        result="$(flr-power cycle 2>/dev/null || true)"
        if [ -n "${result}" ]; then
            notify-send -a "${program}" "Power profile" "${result}" 2>/dev/null || true
        fi
        exit 0
        ;;
    "Keybinding Cheatsheet"*)
        exec flr-keys
        ;;
    "System Diagnostics"*)
        launch_persistent_tui flr-doctor
        ;;
    "System Monitor"*)
        if command -v btop >/dev/null 2>&1; then
            launch_monitor
        fi

        die "btop is required to open the system monitor"
        ;;
    "Snapshots"*)
        launch_persistent_tui "flr-snapshot list"
        ;;
    "Workstation Mode"*)
        exec flr-mode
        ;;
    "Lock Session"*)
        exec hyprlock
        ;;
    "Suspend"*)
        exec systemctl suspend
        ;;
    "Reboot"*)
        exec systemctl reboot
        ;;
    "Shut Down"*)
        exec systemctl poweroff
        ;;
    *)
        exit 0
        ;;
esac
