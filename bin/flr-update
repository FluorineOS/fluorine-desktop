#!/usr/bin/env bash
set -euo pipefail

readonly program="flr-update"
readonly reboot_marker="/var/run/reboot-required"
readonly reboot_pkgs="/var/run/reboot-required.pkgs"

usage() {
    printf 'Usage: %s [--check]\n\n' "${program}"
    printf 'Refresh APT metadata, list incoming FluorineOS and security upgrades, then\n'
    printf 'run the upgrade and report whether a reboot is required. With --check the\n'
    printf 'metadata refresh and listing still happen, but nothing is installed.\n'
}

die() {
    printf '%s: %s\n' "${program}" "$*" >&2
    exit 1
}

check_only=0
case "${1:-}" in
    "")
        ;;
    --check)
        check_only=1
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

command -v apt-get >/dev/null 2>&1 || die "apt-get is required but was not found"

privilege=()
if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || die "sudo or root privileges are required"
    privilege=(sudo)
fi

# A snapshot is only possible when the helper and a Btrfs root are both present.
snapshot_supported() {
    if ! command -v flr-snapshot >/dev/null 2>&1; then
        return 1
    fi

    if ! command -v findmnt >/dev/null 2>&1; then
        return 1
    fi

    [ "$(findmnt -no FSTYPE / 2>/dev/null || true)" = "btrfs" ]
}

rule="--------------------------------------------------------------------------"

printf '%s\n' "${rule}"
printf 'FluorineOS package update\n'
printf '%s\n' "${rule}"

printf '\nRefreshing package metadata\n'
"${privilege[@]}" apt-get update

printf '\nIncoming upgrades\n'
simulation="$(apt-get -s upgrade 2>/dev/null || true)"

if [ -z "${simulation}" ]; then
    die "apt-get could not simulate the upgrade"
fi

total=0
fluorine=0
security=0

while IFS= read -r line; do
    case "${line}" in
        Inst*)
            total=$((total + 1))
            case "${line}" in
                *fluorine-*)
                    fluorine=$((fluorine + 1))
                    printf '  FluorineOS  %s\n' "$(printf '%s' "${line}" | awk '{print $2}')"
                    ;;
            esac
            case "${line}" in
                *security*)
                    security=$((security + 1))
                    printf '  Security    %s\n' "$(printf '%s' "${line}" | awk '{print $2}')"
                    ;;
            esac
            ;;
    esac
done <<< "${simulation}"

if [ "${total}" -eq 0 ]; then
    printf '  No packages to upgrade.\n'
else
    printf '\nSummary: %d package(s) can be upgraded, %d FluorineOS, %d security.\n' \
        "${total}" "${fluorine}" "${security}"
fi

# An upgrade that runs out of space stops after some packages have already been
# replaced, which is the slowest failure to recover from. The floor is one GiB;
# below it the upgrade is still attempted, because the user may have just cleaned
# space and `df` can be stale, but the warning has to come before the changes.
free_kib=$(df -Pk / 2>/dev/null | awk 'NR == 2 { print $4 }' || true)
if [ -n "${free_kib}" ] && [ "${free_kib}" -lt 1048576 ]; then
    printf '\nWarning: %s MiB free on /. An upgrade needs about 1 GiB.\n' \
        "$((free_kib / 1024))"
    printf 'If it stops half way, finish it with:\n'
    printf '  sudo dpkg --configure -a && sudo apt-get -f install\n'
fi

if [ "${check_only}" -eq 1 ]; then
    printf '\nCheck only. No packages were changed.\n'
    exit 0
fi

if [ "${total}" -eq 0 ]; then
    printf '\nThe system is already up to date.\n'
else
    if snapshot_supported; then
        printf '\nCreating a pre-update snapshot\n'
        if ! "${privilege[@]}" flr-snapshot create pre-update; then
            die "pre-update snapshot failed; no packages were changed"
        fi
    fi

    printf '\nApplying the upgrade\n'
    # upgrade, not full-upgrade: it never removes a package to resolve a
    # conflict, so a conflict becomes a visible held-back package instead of an
    # unrequested removal. Removing something stays a decision the user makes.
    "${privilege[@]}" apt-get upgrade
fi

printf '\n%s\n' "${rule}"
if [ -f "${reboot_marker}" ]; then
    printf 'A reboot is required to finish the update.\n'
    if [ -f "${reboot_pkgs}" ]; then
        printf 'Packages that requested it:\n'
        sed 's/^/  /' "${reboot_pkgs}"
    fi
else
    printf 'No reboot is required.\n'
fi

if [ "${total}" -gt 0 ]; then
    printf 'Log out and back in to load updated desktop configuration.\n'
fi

if snapshot_supported; then
    printf 'Roll back with: flr-snapshot rollback <id>\n'
fi

printf '%s\n' "${rule}"
