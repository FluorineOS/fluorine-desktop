#!/usr/bin/env python3
"""FluorineOS Sync.

A declarative dotfile and state manager for the FluorineOS desktop. The tool
exports user configurations into versioned archives, keeps a local Git history
that can be pushed to a remote for cross-machine sync, restores state with a
dry-run conflict preview and an automatic Btrfs pre-restore snapshot, and
compares the live configuration against the tracked snapshot.
"""

import os
import shutil
import subprocess
import sys
import tarfile
import threading
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

APP_ID = "org.fluorineos.Sync"
FLR_SYNC_VERSION = "0.1.0"

CSS = """
window {
    background-color: #000000;
    color: #e2e8f0;
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 13px;
}

