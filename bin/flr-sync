    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: #e2e8f0;
}

.panel {
    background: #0a0d10;
    border: 1.5px solid #1c2229;
    padding: 12px 14px;
}

.panel-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #6e7681;
}

.status-text {
    font-size: 12px;
    color: #e2e8f0;
