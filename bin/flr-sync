    background: #2a3812;
    border-color: #b4f03a;
}
"""

# Archive paths are relative to the home directory, so restore can write each
# entry straight back to its original location on a fresh installation.
SOURCES = (
    (".config/fluorine", Path.home() / ".config" / "fluorine"),
    (".config/hypr", Path.home() / ".config" / "hypr"),
    (".config/waybar", Path.home() / ".config" / "waybar"),
    (".bashrc", Path.home() / ".bashrc"),
    (".bash_aliases", Path.home() / ".bash_aliases"),
)


def run(command, timeout=10, cwd=None):
    """Run a command and return the completed process, or None."""
    try:
        return subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
            cwd=cwd,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def available(program):
    return shutil.which(program) is not None


def os_release(field):
    try:
        text = Path("/etc/os-release").read_text(encoding="utf-8")
    except OSError:
        return "unknown"
    for line in text.splitlines():
        if line.startswith(field + "="):
            return line.split("=", 1)[1].strip().strip('"')
    return "unknown"


def state_dir():
    base = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
    return base / "fluorine" / "sync"


def snapshots_dir():
    return state_dir() / "snapshots"


def repo_dir():
    return state_dir() / "repo"


def remote_file():
    return state_dir() / "remote"


def tracked_files():
    """Yield (home-relative path, live file) for every tracked configuration."""
    for relative, source in SOURCES:
        if source.is_dir():
            for child in sorted(source.rglob("*")):
                if child.is_file():
                    yield relative + "/" + child.relative_to(source).as_posix(), child
        elif source.is_file():
            yield relative, source


def safe_relative(name):
    """Reject absolute or traversing paths from an imported snapshot."""
    path = Path(name)
    return not path.is_absolute() and ".." not in path.parts


def timestamp():
    return time.strftime("%Y%m%dT%H%M%S", time.gmtime())


def backup_archive():
    directory = snapshots_dir()
    directory.mkdir(parents=True, exist_ok=True)
    stamp = timestamp()
    path = directory / ("flr-sync-%s.tar.gz" % stamp)
    if path.exists():
        path = directory / ("flr-sync-%s-%s.tar.gz" % (stamp, os.getpid()))
    with tarfile.open(path, "w:gz") as archive:
        # Dereference symlinks so archives, status, and the Git mirror all
        # hold the same regular file contents.
        archive.dereference = True
        for relative, source in tracked_files():
            archive.add(source, arcname=relative, recursive=False)
    return path


def latest_archive():
    directory = snapshots_dir()
    if not directory.is_dir():
        return None
    candidates = sorted(directory.glob("flr-sync-*.tar.gz"))
    return str(candidates[-1]) if candidates else None


def snapshot_items(path=None, from_git=False):
    """Yield (home-relative path, bytes) from an archive or the Git checkout."""
    if from_git:
        directory = repo_dir()
        if not directory.is_dir():
            return []
        items = []
        for child in sorted(directory.rglob("*")):
            if not child.is_file() or ".git" in child.parts:
                continue
            relative = child.relative_to(directory)
            if safe_relative(relative.as_posix()):
                items.append((relative.as_posix(), child.read_bytes()))
        return items

    if not path:
        return []
    items = []
    with tarfile.open(str(path), "r:gz") as archive:
        for member in archive.getmembers():
            if not member.isfile() or not safe_relative(member.name):
                continue
            handle = archive.extractfile(member)
            items.append((member.name, handle.read() if handle else b""))
    return items


def file_bytes(path):
    try:
        return path.read_bytes()
    except OSError:
        return None


def btrfs_root_mounted():
    try:
        lines = Path("/proc/mounts").read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    for line in lines:
        parts = line.split()
        if len(parts) >= 4 and parts[2] == "btrfs" and parts[1] == "/":
            return True
    return False


def snapshot_command():
    """Return the argv that creates a pre-restore snapshot, or None."""
    helper = shutil.which("flr-snapshot")
    if helper is None:
        return None
    if os.geteuid() == 0:
        return [helper, "create", "flr-sync-pre-restore"]
    if shutil.which("pkexec") is not None and (
        os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")
    ):
        return ["pkexec", helper, "create", "flr-sync-pre-restore"]
    if shutil.which("sudo") is not None:
        return ["sudo", helper, "create", "flr-sync-pre-restore"]
    return None


def pre_restore_snapshot():
    """Create one rollback point before any restore writes files."""
    if not btrfs_root_mounted():
        try:
            archive = backup_archive()
        except OSError as error:
            return False, "pre-restore archive failed; restore aborted: %s" % error
        return True, "no btrfs root; saved pre-restore archive %s" % archive
    command = snapshot_command()
    if command is None:
        return False, "no privileged snapshot helper available; restore aborted"
    result = run(command, timeout=180)
    if result is None:
        return False, "pre-restore snapshot could not run; restore aborted"
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        suffix = ": " + detail if detail else ""
        return False, "pre-restore snapshot failed; restore aborted" + suffix
    return True, "created pre-restore snapshot flr-sync-pre-restore"


def restore_snapshot(path=None, dry_run=False, from_git=False, confirmed=False):
    """Return (ok, report lines). Never writes without confirmation."""
    if not dry_run and not confirmed:
        return False, ["refusing to restore without confirmation; pass --yes"]

    try:
        items = snapshot_items(path, from_git=from_git)
    except (OSError, tarfile.TarError) as error:
        return False, ["error: cannot read snapshot: %s" % error]
    if not items:
        return False, ["no tracked snapshot found"]

    report = []
    if not dry_run:
        ok, message = pre_restore_snapshot()
        report.append(message)
        if not ok:
            return False, report

    try:
        for name, data in items:
            target = Path.home() / name
            if dry_run:
                if not target.exists():
                    report.append("missing " + name)
                elif (file_bytes(target) or b"") != data:
                    report.append("would-overwrite " + name)
                else:
                    report.append("unchanged " + name)
                continue
            if target.is_symlink() or (target.exists() and not target.is_file()):
                report.append("error: target is not a regular file " + name)
                return False, report
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            report.append("restored " + name)
    except OSError as error:
        report.append("error: restore failed: %s" % error)
        return False, report
    return True, report


def status_snapshot(path=None, from_git=False):
    """Return (ok, comparison lines)."""
    try:
        items = snapshot_items(path, from_git=from_git)
    except (OSError, tarfile.TarError) as error:
        return False, ["error: cannot read snapshot: %s" % error]
    if not items:
        return False, ["no tracked snapshot found"]
    lines = []
    for name, data in items:
        local = Path.home() / name
        if not local.exists():
            lines.append("missing " + name)
        elif (file_bytes(local) or b"") != data:
            lines.append("changed " + name)
        else:
            lines.append("ok " + name)
    return True, lines


def git(args, timeout=60):
    if not available("git"):
        return None
    return run(["git"] + list(args), timeout=timeout, cwd=repo_dir())


def sync_git_repo(push=False):
    """Version the tracked files locally and optionally push to a remote."""
    if not available("git"):
        return False, ["git not installed; local archive only"]

    directory = repo_dir()
    directory.mkdir(parents=True, exist_ok=True)
    if not (directory / ".git").exists():
        result = git(["init", "-q"])
        if result is None or result.returncode != 0:
            return False, ["git init failed; local archive only"]

    # Never prune repo files here. On a fresh machine the live configs do not
    # exist yet, and pruning would delete the checkout needed for --from-git.
    for relative, source in tracked_files():
        destination = directory / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)

    result = git(["add", "-A"])
    if result is None or result.returncode != 0:
        return False, ["git add failed; local archive only"]

    result = git(["diff", "--cached", "--quiet"])
    lines = []
    if result is not None and result.returncode == 1:
        commit = git(["commit", "-q", "-m", "flr-sync state %s" % timestamp()])
        if commit is not None and commit.returncode == 0:
            lines.append("committed tracked state to local git repository")
        else:
            return False, ["git commit failed; local archive only"]
    else:
        lines.append("local git repository already up to date")

    if not push:
        return True, lines

    try:
        url = remote_file().read_text(encoding="utf-8").strip()
    except OSError:
        url = ""
    if not url:
        return False, lines + ["no remote configured; use 'flr-sync remote set URL'"]

    git(["remote", "remove", "origin"])
    result = git(["remote", "add", "origin", url])
    if result is None or result.returncode != 0:
        return False, lines + ["git remote setup failed"]
    result = git(["push", "-q", "-u", "origin", "HEAD"])
    if result is None or result.returncode != 0:
        return False, lines + ["git push failed; local archive and commit are intact"]
    return True, lines + ["pushed tracked state to remote"]


def perform_backup(push=False):
    """Return (ok, report lines)."""
    try:
        archive = backup_archive()
    except OSError as error:
        return False, ["error: backup failed: %s" % error]
    lines = ["backup wrote %s" % archive]
    ok, git_lines = sync_git_repo(push=push)
    return ok, lines + git_lines


class SyncWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("FluorineOS Sync")
        self.set_default_size(820, 520)
        self.set_size_request(640, 420)
        self.busy = False
        self.restore_previewed = False
        self.preview_target = None
        self.result = []

        self.toast_overlay = Adw.ToastOverlay()
        self.toolbar = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar)

        header = Adw.HeaderBar()
        header.set_title_widget(
            Adw.WindowTitle(
                title="FluorineOS Sync",
                subtitle=os_release("PRETTY_NAME"),
            )
        )
        self.status_pill = Gtk.Label(label="")
        self.status_pill.add_css_class("status-pill")
        self.status_pill.set_visible(False)
        header.pack_end(self.status_pill)
        self.toolbar.add_top_bar(header)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        body.set_margin_top(16)
        body.set_margin_bottom(16)
        body.set_margin_start(16)
        body.set_margin_end(16)
        body.set_vexpand(True)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.add_css_class("panel")
        frame.set_vexpand(True)
        heading = Gtk.Label(label="SYNC STATUS", xalign=0)
        heading.add_css_class("panel-title")
        frame.append(heading)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        self.status_body = Gtk.Label(label="no snapshot tracked", xalign=0, wrap=True)
        self.status_body.add_css_class("status-text")
        self.status_body.set_selectable(True)
        scroll.set_child(self.status_body)
        frame.append(scroll)
        body.append(frame)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.buttons = {}
        for label, action, style in (
            ("Backup State", "backup", "action"),
            ("Preview Changes", "preview", None),
            ("Restore Configs", "restore", None),
            ("View Sync Status", "status", None),
            ("Push to Remote", "push", None),
        ):
            button = Gtk.Button(label=label)
            button.set_cursor_from_name("pointer")
            if style:
                button.add_css_class(style)
            button.connect("clicked", self.on_action, action)
            buttons.append(button)
            self.buttons[action] = button
        body.append(buttons)

        self.toolbar.set_content(body)
        self.set_content(self.toast_overlay)

    def toast(self, message):
        self.toast_overlay.add_toast(Adw.Toast.new(message))

    def flash_status(self, message, milliseconds=2000):
        self.status_pill.set_text(message)
        self.status_pill.set_visible(True)
        if getattr(self, "_status_timeout", None):
            GLib.source_remove(self._status_timeout)
        self._status_timeout = GLib.timeout_add(milliseconds, self._hide_status)

    def _hide_status(self):
        self._status_timeout = None
        self.status_pill.set_visible(False)
        return False

    def show_result(self, lines):
        self.status_body.set_text("\n".join(lines) or "done")

    def set_busy(self, busy):
        self.busy = busy
        for button in self.buttons.values():
            button.set_sensitive(not busy)

    def clear_preview(self):
        self.restore_previewed = False
        self.preview_target = None
        self.buttons["restore"].set_label("Restore Configs")

    def on_action(self, _button, action):
        if self.busy:
            return
        if action in ("backup", "push"):
            self.clear_preview()
        confirmed = action == "restore" and self.restore_previewed
        self.set_busy(True)
        self.flash_status("working")
        worker = threading.Thread(
            target=self.worker, args=(action, confirmed), daemon=True
        )
        worker.start()

    def worker(self, action, confirmed):
        """Run one action off-thread; marshal every UI change to the main loop."""
        ok = True
        target = None
        try:
            if action == "backup":
                ok, self.result = perform_backup(push=False)
            elif action == "preview":
                target = latest_archive()
                ok, self.result = restore_snapshot(target, dry_run=True)
            elif action == "restore":
                target = self.preview_target if confirmed else latest_archive()
                ok, self.result = restore_snapshot(
                    target, dry_run=not confirmed, confirmed=confirmed
                )
            elif action == "status":
                ok, self.result = status_snapshot(latest_archive())
            elif action == "push":
                ok, self.result = sync_git_repo(push=True)
        except Exception as error:  # keep the UI responsive on unexpected errors
            self.result = ["error: %s" % error]
            ok = False
        finally:
            GLib.timeout_add(0, self.on_worker_done, action, confirmed, ok, target)

    def on_worker_done(self, action, confirmed, ok, target):
        self.set_busy(False)
        self.show_result(self.result)
        self.flash_status("done" if ok else "failed")

        if action == "preview" and ok:
            self.restore_previewed = True
            self.preview_target = target
            self.buttons["restore"].set_label("Confirm Restore")
            self.toast("Conflict preview ready")
        elif action == "restore":
            if confirmed:
                self.clear_preview()
                self.toast("Restore complete" if ok else "Restore failed")
            elif ok:
                self.restore_previewed = True
                self.preview_target = target
                self.buttons["restore"].set_label("Confirm Restore")
                self.toast("Preview shown; click again to apply")
            else:
                self.clear_preview()
                self.toast("No snapshot to restore")
        elif action == "backup":
            self.toast("Backup complete" if ok else "Backup failed")
        elif action == "status":
            self.toast("Status refreshed" if ok else "Status failed")
        elif action == "push":
            self.toast("Remote sync complete" if ok else "Remote sync failed")
        return False


class SyncApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        window = self.get_active_window()
        if window is None:
            window = SyncWindow(application=self)
        window.present()


def usage():
    print("usage: flr-sync <command> [argument] [options]")
    print("commands:")
    print("  backup [--push]                Write a versioned archive and commit state")
    print("  restore [latest|ARCHIVE] [--yes]")
    print("                                 Restore after confirmation and a pre-restore check")
    print("  status [latest|ARCHIVE]        Compare local files with a snapshot")
    print("  remote set URL                 Set the Git remote used by backup --push")
    print("  remote show                    Show the configured Git remote")
    print("  gui                            Open the GTK4 companion interface")
    print("options:")
    print("  --dry-run                      Preview conflicts without writing files")
    print("  --yes                          Confirm a CLI restore (required unless --dry-run)")
    print("  --from-git                     Read state from the local Git checkout")
    print("  --version                      Show the flr-sync version")
    print("  -h, --help                     Show this help")


def emit(ok, lines):
    for line in lines:
        print(line)
    return 0 if ok else 1


def cli(argv):
    if not argv:
        usage()
        return 2
    if "-h" in argv or "--help" in argv:
        usage()
        return 0
    if "--version" in argv:
        print("flr-sync " + FLR_SYNC_VERSION)
        return 0

    command = argv[0]
    rest = argv[1:]
    dry_run = "--dry-run" in rest
    from_git = "--from-git" in rest

    if command == "backup":
        unknown = [item for item in rest if item != "--push"]
        if len(rest) > 1 or len(set(rest)) != len(rest) or unknown:
            usage()
            return 2
        return emit(*perform_backup(push="--push" in rest))

    if command in ("restore", "status"):
        allowed = {"--dry-run", "--from-git"}
        if command == "restore":
            allowed.add("--yes")
        unknown = [item for item in rest if item.startswith("--") and item not in allowed]
        positionals = [item for item in rest if not item.startswith("--")]
        if unknown or len(positionals) > 1:
            usage()
            return 2
        target = positionals[0] if positionals else "latest"
        if from_git and target != "latest":
            usage()
            return 2
        if target == "latest":
            target = None if from_git else latest_archive()
        if command == "restore":
            return emit(
                *restore_snapshot(
                    target,
                    dry_run=dry_run,
                    from_git=from_git,
                    confirmed="--yes" in rest,
                )
            )
        if dry_run:
            usage()
            return 2
        return emit(*status_snapshot(target, from_git=from_git))

    if command == "remote":
        if len(rest) == 2 and rest[0] == "set" and not rest[1].startswith("-"):
            directory = state_dir()
            directory.mkdir(parents=True, exist_ok=True)
            remote_file().write_text(rest[1] + "\n", encoding="utf-8")
            print("remote set to " + rest[1])
            return 0
        if rest == ["show"]:
            try:
                url = remote_file().read_text(encoding="utf-8").strip()
            except OSError:
                url = ""
            print(url or "no remote configured")
            return 0
        usage()
        return 2

    if command == "gui" and not rest:
        return SyncApp().run([])

    usage()
    return 2


def main(argv):
    if argv and argv[0] == "--gui":
        return SyncApp().run([])
    return cli(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
